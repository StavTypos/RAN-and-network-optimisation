' ============================================================
' 4G – Attach / TAU / Service Request Failure
' ============================================================
@startuml
title 4G – Attach / TAU / Service Request Failure

participant UE
participant eNB as "eNodeB"
participant MME
participant "HSS/DB" as HSS

UE -> eNB: RRC Connection Request
eNB -> MME: S1AP Initial UE Message (Attach/TAU)
MME -> HSS: Update Location / Authentication Info
HSS --> MME: Auth vectors / subscriber data
MME -> UE: Authentication Request (via eNB)
UE --> MME: Authentication Response

alt Success
  MME -> SGW: Create Session Request
  SGW -> PGW: Create Default Bearer
  MME -> UE: Attach Accept (via eNB)
else Failure
  MME --> eNB: S1AP Failure / Context Setup Failure
  eNB -> UE: RRC Release / Attach Reject
end
@enduml


' ============================================================
' 4G – RRC Connection Failure / RLF
' ============================================================
@startuml
title 4G – RRC Connection Failure / RLF / Re-establishment Loop

participant UE
participant eNB as "eNodeB"

UE -> eNB: RRC Connection Setup Request
eNB -> UE: RRC Connection Setup
UE -> eNB: RRC Connection Setup Complete

note over UE,eNB: Radio link fails (RLF)

UE -> eNB: RRC Re-establishment Request

alt Re-establishment success
  eNB -> UE: RRC Re-establishment
else Failure
  eNB -> UE: RRC Re-establishment Reject
  UE -> MME: Triggers TAU / Attach retry
end
@enduml


' ============================================================
' 4G – S1AP Setup / Context Setup / Path Switch Errors
' ============================================================
@startuml
title 4G – S1AP Errors (S1 Setup / Context Setup / Path Switch)

participant eNB as "eNodeB"
participant MME
participant SGW

eNB -> MME: S1 Setup Request
alt S1 Setup Success
  MME -> eNB: S1 Setup Response
else Failure
  MME --> eNB: S1 Setup Failure
end

== Context / Path Switch ==
eNB -> MME: Initial Context Setup Request
MME -> SGW: Modify Bearer / Path Switch Req

alt Success
  SGW --> MME: Modify Bearer Response
  MME -> eNB: Initial Context Setup Response
else Failure
  SGW --> MME: Error / timeout
  MME --> eNB: Context Setup Failure
end
@enduml


' ============================================================
' 4G – Handover Failure (X2 / S1)
' ============================================================
@startuml
title 4G – Handover Failure (X2 / S1 based)

participant UE
participant src_eNB as "Source eNodeB"
participant tgt_eNB as "Target eNodeB"
participant MME

src_eNB -> tgt_eNB: X2 Handover Request
tgt_eNB -> src_eNB: X2 Handover Request Ack

src_eNB -> UE: RRC Reconfiguration (HO Command)
UE -> tgt_eNB: RRC Reconfiguration Complete

tgt_eNB -> MME: Path Switch Request

alt Success
  MME -> SGW: Update Bearer
  SGW --> MME: Update Bearer Response
  MME -> tgt_eNB: Path Switch Ack
else Failure
  tgt_eNB -> src_eNB: Handover Failure
  src_eNB -> UE: RRC Re-establish or Release
end
@enduml


' ============================================================
' 4G – EPS Bearer Establishment Failure
' ============================================================
@startuml
title 4G – EPS Bearer Establishment Failure

participant UE
participant eNB as "eNodeB"
participant MME
participant SGW
participant PGW
participant PCRF

UE -> eNB: PDN Connectivity Request
eNB -> MME: Forward PDN Request
MME -> SGW: Create Session Request
SGW -> PGW: Create Session
PGW -> PCRF: Policy Request

alt Success
  PGW --> SGW: Session Created
  SGW --> MME: Create Session Response
  MME -> eNB: Activate Default Bearer
else Failure
  PGW --> SGW: Reject (DNN/APN/policy)
  SGW --> MME: Create Session Failure
  MME -> eNB: Attach / PDN Reject
end
@enduml


' ============================================================
' 4G – Paging Failure
' ============================================================
@startuml
title 4G – Paging Failure

participant MME
participant eNB as "eNodeB"
participant UE

MME -> eNB: Paging Request
eNB -> UE: Paging Indication

alt UE reachable
  UE -> eNB: RRC Connection Request
  eNB -> MME: Paging Response
else Fail
  note right: No response (coverage / DRX / wrong TA)
end
@enduml


' ============================================================
' 4G – VoLTE / IMS Signalling Issue (SIP Failure)
' ============================================================
@startuml
title 4G – VoLTE / IMS Registration or SIP Failure

participant UE
participant eNB as "eNodeB"
participant PCSCF
participant ICSCF
participant SCSCF as "SCSCF"
participant MME

UE -> PCSCF: SIP REGISTER
PCSCF -> ICSCF: Forward
ICSCF -> SCSCF: Forward

alt Success
SCSCF -> UE: 200 OK
else Failure
SCSCF --> UE: SIP Error (403/503)
end
@enduml


' ============================================================
' 5G NSA – EN-DC SCG Addition Failure
' ============================================================
@startuml
title 5G NSA – EN-DC / SCG Addition Failure

participant UE
participant eNB as "LTE Master eNB"
participant gNB as "NR gNodeB"

UE -> eNB: Measurement Report
eNB -> gNB: SCG Addition Request
gNB -> eNB: SCG Addition Response

eNB -> UE: RRC Reconfig (Add SCG)
UE -> gNB: RRC Reconfig Complete

alt Success
  note right: NR SCG Activated
else Failure
  gNB --> eNB: SCG Addition Failure
  eNB -> UE: Revert to LTE
end
@enduml


' ============================================================
' 5G NSA – PDCP Duplication / User-plane Split Issue
' ============================================================
@startuml
title 5G NSA – PDCP Duplication / User-plane Split Issue

participant UE
participant eNB as "LTE Master"
participant gNB as "NR Secondary"

UE -> eNB: PDCP Config
eNB -> gNB: DRB Setup

alt Success
  eNB -> gNB: PDCP Split / Duplication
else Failure
  gNB --> eNB: DRB Setup Failure
  eNB -> UE: PDCP Reconfig Reject
end
@enduml


' ============================================================
' 5G SA – Registration Failure (AMF / NSSAI / N1N2)
' ============================================================
@startuml
title 5G SA – Registration Failure (NSSAI/AMF)

participant UE
participant gNB as "gNodeB"
participant AMF
participant UDM

UE -> gNB: Registration Request
gNB -> AMF: NGAP Initial UE Message
AMF -> UDM: Subscription Check

alt Success
  AMF -> UE: Registration Accept (via gNB)
else Failure
  AMF -> UE: Registration Reject (via gNB)
end
@enduml


' ============================================================
' 5G SA – PDU Session Establishment Failure
' ============================================================
@startuml
title 5G SA – PDU Session Establishment Failure

participant UE
participant gNB as "gNodeB"
participant AMF
participant SMF
participant UPF

UE -> gNB: PDU Session Request
gNB -> AMF: Forward to SMF
AMF -> SMF: Create PDU Session
SMF -> UPF: PFCP Session Establishment

alt Success
  UPF --> SMF: PFCP Response
  SMF -> UE: PDU Session Accept (via AMF/gNB)
else Failure
  SMF --> UE: PDU Session Reject (via AMF/gNB)
end
@enduml


' ============================================================
' 5G – NGAP Errors (Initial Context Setup / Path Switch)
' ============================================================
@startuml
title 5G – NGAP Errors (Initial Context Setup / Path Switch)

participant gNB as "gNodeB"
participant AMF
participant SMF
participant UPF

gNB -> AMF: Initial Context Setup Request
AMF -> SMF: PDU Session Setup

alt Success
  SMF -> UPF: PFCP Establish
  AMF -> gNB: Initial Context Setup Response
else Failure
  AMF -> gNB: Initial Context Setup Failure
end
@enduml


' ============================================================
' 5G – Beam Failure / Beam Recovery / HO Failure
' ============================================================
@startuml
title 5G – Beam Failure / Beam Recovery / HO Failure

participant UE
participant gNB as "Serving gNB"
participant tgt_gNB as "Target gNB"
participant AMF

UE -> gNB: Measurement Report (beam degraded)
gNB -> UE: Beam Recovery RRC Reconfig

alt Beam recovery success
  UE -> gNB: Reconfig Complete
else Beam failure
  UE -> gNB: Beam Failure Indication
  gNB -> AMF: Handover Required
  AMF -> tgt_gNB: HO Request

  alt HO Success
    tgt_gNB -> AMF: HO Ack
  else HO Failure
    tgt_gNB --> AMF: HO Reject
    gNB -> UE: RRC Release
  end
end
@enduml


' ============================================================
' 5G – Network Slice Selection / Activation Failure
' ============================================================
@startuml
title 5G – Network Slice Selection / Activation Failure

participant UE
participant gNB as "gNodeB"
participant AMF
participant NSSF
participant SMF

UE -> gNB: Registration (with S-NSSAI)
gNB -> AMF: NGAP Initial

AMF -> NSSF: Slice Selection

alt Slice Available
  AMF -> SMF: Create PDU for Slice
  SMF -> UE: PDU Session Setup
else Slice Not Allowed
  AMF -> UE: Reject (via gNB)
end
@enduml
